<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MiDeuda.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MiDeuda.App"
    Title="Mi Deuda">

    <!-- Barra de pestañas principal -->
    <TabBar>
        <Tab Title="Gastos" Icon="dotnet_bot.png">
            <ShellContent
                Title="Gastos"
                ContentTemplate="{DataTemplate local:MainPage}"
                Route="MainPage" />
        </Tab>

        <Tab Title="Facturas" Icon="dotnet_bot.png">
            <ShellContent
                Title="Facturas"
                ContentTemplate="{DataTemplate local:FacturasPage}"
                Route="FacturasPage" />
        </Tab>
    </TabBar>

</Shell>