<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MiDeuda.App"
             x:Class="MiDeuda.App.MainPage"
             BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#0F172A}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:CategoriaColorConverter x:Key="CatColorConverter" />
            <local:EsDolarConverter x:Key="EsDolarConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- MaximumWidthRequest centra y limita el ancho en Windows para que parezca un celular -->
    <Grid RowDefinitions="Auto,*" MaximumWidthRequest="480" HorizontalOptions="Center">

        <!-- CABECERA FIJA Y FORMULARIO -->
        <VerticalStackLayout Grid.Row="0" Padding="16,24,16,10" Spacing="20">

            <!-- Título de la app -->
            <Label Text="Mi Deuda" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}"/>

            <!-- Tarjeta de Balance Flotante -->
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 24" Padding="24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6366F1" Offset="0.0" />
                        <GradientStop Color="#A855F7" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#6366F1" Offset="0,8" Radius="16" Opacity="0.3" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="8">

                    <Label x:Name="LblTituloTotal"
                           Text="Total Gastado Hoy" 
                           TextColor="#E0E7FF" 
                           FontSize="14" />
                    <Label x:Name="LblTotalGastos" 
                           Text="$ 0,00" 
                           TextColor="White" 
                           FontSize="36" 
                           FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <!-- Mini Formulario de Ingreso Rápido -->
            <Border StrokeThickness="0" 
                    StrokeShape="RoundRectangle 20" 
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}" 
                    Padding="16">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.05" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Entry x:Name="TxtDescripcion" Grid.Column="0"
                               Placeholder="¿En qué gastaste?" 
                               PlaceholderColor="Gray"
                               FontSize="16"
                               BackgroundColor="Transparent" />
                        <Picker x:Name="CboCategoria" Grid.Column="1"
                                Title="Categoría" 
                                WidthRequest="110" 
                                FontSize="14"
                                BackgroundColor="Transparent">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Comida</x:String>
                                    <x:String>Transporte</x:String>
                                    <x:String>Servicios</x:String>
                                    <x:String>Salud</x:String>
                                    <x:String>Varios</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E5E7EB, Dark=#334155}" />

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Entry x:Name="TxtMonto" Grid.Column="0"
                               Placeholder="0.00" 
                               Keyboard="Numeric" 
                               FontSize="20" 
                               FontAttributes="Bold"
                               BackgroundColor="Transparent"
                               TextChanged="OnMonedaOrMontoChanged"/>

                        <Picker x:Name="CboMoneda" Grid.Column="1"
                                Title="ARS" 
                                WidthRequest="95" 
                                FontSize="14"
                                FontAttributes="Bold"
                                BackgroundColor="Transparent"
                                SelectedIndexChanged="OnMonedaOrMontoChanged">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>ARS</x:String>
                                    <x:String>USD</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>

                        <!-- Botón modificado para decir "Agregar" -->
                        <Button Grid.Column="2"
                                Text="Agregar" 
                                FontSize="15"
                                FontAttributes="Bold"
                                BackgroundColor="#10B981" 
                                TextColor="White" 
                                CornerRadius="12"
                                HeightRequest="48"
                                Padding="16,0"
                                Clicked="OnGuardarGastoClicked" />
                    </Grid>

                    <!-- Etiqueta de conversión que aparece al elegir USD -->
                    <Label x:Name="LblConversion" 
                           FontSize="12" 
                           TextColor="#10B981" 
                           FontAttributes="Bold"
                           IsVisible="False" 
                           Margin="0,-4,0,0" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Últimos Movimientos" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light=#374151, Dark=#94A3B8}" 
                   Margin="4,10,0,0"/>
        </VerticalStackLayout>

        <!-- LISTA ESCROLLEABLE -->
        <CollectionView x:Name="ListaGastosView" 
                        Grid.Row="1" 
                        SelectionMode="None"
                        Margin="0,0,0,20">

            <!-- ItemsLayout agregado para darle espaciado ("aire") a las tarjetas -->
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0,40,0,0">
                    <Label Text="💸" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="No hay gastos registrados aún" TextColor="Gray" FontSize="14" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Borrar" BackgroundColor="#EF4444" 
                                           Invoked="OnEliminarGastoInvoked" 
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <!-- Diseño de cada Item de la lista con margen corregido a 16,0 -->
                        <Border StrokeThickness="0" 
                                StrokeShape="RoundRectangle 16" 
                                Margin="16,0" 
                                Padding="16" 
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}">

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                <!-- Indicador de color de Categoría -->
                                <BoxView Grid.Column="0" 
                                         WidthRequest="4" 
                                         CornerRadius="2"
                                         BackgroundColor="{Binding Categoria, Converter={StaticResource CatColorConverter}}" />

                                <!-- Detalle Izquierda -->
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding Descripcion}" 
                                           FontSize="16" 
                                           FontAttributes="Bold" 
                                           TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}"/>
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{Binding Categoria}" FontSize="12" TextColor="Gray" />
                                        <Label Text="•" FontSize="12" TextColor="Gray" />
                                        <Label Text="{Binding Fecha, StringFormat='{0:dd/MM}'}" FontSize="12" TextColor="Gray" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Montos Derecha -->
                                <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center" HorizontalOptions="End">
                                    <HorizontalStackLayout Spacing="4" HorizontalOptions="End">
                                        <!-- Badge de Moneda -->
                                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 6" BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#312E81}" Padding="4,2" VerticalOptions="Center">
                                            <Label Text="{Binding Moneda}" FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4F46E5, Dark=#A5B4FC}"/>
                                        </Border>
                                        <Label Text="{Binding Monto, StringFormat='${0:N2}'}" 
                                               FontSize="16" 
                                               FontAttributes="Bold" 
                                               TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}" />
                                    </HorizontalStackLayout>

                                    <Label Text="{Binding MontoEnPesos, StringFormat='≈ ${0:N0} ARS'}" 
                                           FontSize="11" 
                                           TextColor="#10B981" 
                                           HorizontalOptions="End"
                                           IsVisible="{Binding Moneda, Converter={StaticResource EsDolarConverter}}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>