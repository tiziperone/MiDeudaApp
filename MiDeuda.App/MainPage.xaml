<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiDeuda.App.MainPage"
             Title="Control de Gastos"
             BackgroundColor="{AppThemeBinding Light=#F5F7FB, Dark=#1E1E1E}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- TARJETA: TOTAL ACUMULADO -->
            <Border StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light=#512BD4, Dark=#381E8D}"
                    Padding="20">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Total Gastos Registrados"
                           TextColor="White"
                           FontSize="14"
                           Opacity="0.8" />
                    <Label x:Name="LblTotalGastos"
                           Text="$ 0,00"
                           TextColor="White"
                           FontSize="28"
                           FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <!-- FORMULARIO DE CARGA -->
            <Border StrokeShape="RoundRectangle 12"
                    Padding="16"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D2D}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Nuevo Gasto"
                           FontSize="18"
                           FontAttributes="Bold" />

                    <!-- Descripción -->
                    <Entry x:Name="TxtDescripcion"
                           Placeholder="Descripción (ej. Supermercado, Nafta)" />

                    <!-- Monto y Moneda -->
                    <Grid ColumnDefinitions="2*,1*" ColumnSpacing="10">
                        <Entry x:Name="TxtMonto"
                               Grid.Column="0"
                               Placeholder="Monto"
                               Keyboard="Numeric" />
                        <Picker x:Name="CboMoneda"
                                Grid.Column="1"
                                Title="Moneda">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>ARS</x:String>
                                    <x:String>USD</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Grid>

                    <!-- Categoría y Fecha -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Picker x:Name="CboCategoria"
                                Grid.Column="0"
                                Title="Categoría">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Comida</x:String>
                                    <x:String>Transporte</x:String>
                                    <x:String>Servicios</x:String>
                                    <x:String>Salud</x:String>
                                    <x:String>Varios</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                        <DatePicker x:Name="DtpFecha"
                                    Grid.Column="1"
                                    Format="dd/MM/yyyy" />
                    </Grid>

                    <!-- Botón Guardar -->
                    <Button Text="Guardar Gasto"
                            BackgroundColor="#512BD4"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            Clicked="OnGuardarGastoClicked"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- LISTADO DE GASTOS -->
            <Label Text="Historial de Gastos"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <CollectionView x:Name="ListaGastosView"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No hay gastos registrados todavía."
                           HorizontalOptions="Center"
                           Margin="0,20"
                           TextColor="Gray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 8"
                                Padding="12"
                                Margin="0,4"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D2D}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Descripcion}"
                                       FontAttributes="Bold"
                                       FontSize="16" />

                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Monto, StringFormat='${0:N2}'}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="#E74C3C" />

                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="{Binding Gasto, StringFormat='Categoría: {0}'}"
                                       FontSize="12"
                                       TextColor="Gray" />

                                <Label Grid.Row="1" Grid.Column="1"
                                       Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}"
                                       FontSize="12"
                                       TextColor="Gray" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>