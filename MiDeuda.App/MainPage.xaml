<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MiDeuda.App"
             x:Class="MiDeuda.App.MainPage"
             Title="Mi Deuda"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#121212}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:CategoriaColorConverter x:Key="CatColorConverter" />
            <local:EsDolarConverter x:Key="EsDolarConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- TARJETA PRINCIPAL CON GRADIENTE -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    Padding="22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4F46E5" Offset="0.1" />
                        <GradientStop Color="#7C3AED" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#4F46E5" Offset="0,6" Radius="12" Opacity="0.25" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Gasto Total Acumulado"
                           TextColor="#E0E7FF"
                           FontSize="13"
                           FontAttributes="Bold"
                           CharacterSpacing="0.5" />
                    <Label x:Name="LblTotalGastos"
                           Text="$ 0,00"
                           TextColor="White"
                           FontSize="32"
                           FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <!-- FORMULARIO DE REGISTRO ESTILO TARJETA -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#27272A}"
                    StrokeThickness="1"
                    Padding="16"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Nuevo Registro"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#F4F4F5}" />

                    <!-- Descripción -->
                    <Border StrokeShape="RoundRectangle 10"
                            Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#3F3F46}"
                            StrokeThickness="1"
                            Padding="12,0"
                            BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#27272A}">
                        <Entry x:Name="TxtDescripcion"
                               Placeholder="Concepto (ej. Alquiler, Combustible)"
                               PlaceholderColor="Gray"
                               FontSize="14" />
                    </Border>

                    <!-- Monto y Moneda -->
                    <Grid ColumnDefinitions="2*,1*" ColumnSpacing="8">
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#3F3F46}"
                                StrokeThickness="1"
                                Padding="12,0"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#27272A}">
                            <Entry x:Name="TxtMonto"
                                   Placeholder="0.00"
                                   PlaceholderColor="Gray"
                                   Keyboard="Numeric"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextChanged="OnMonedaOrMontoChanged" />
                        </Border>

                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#3F3F46}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#27272A}">
                            <Picker x:Name="CboMoneda"
                                    Title="Moneda"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    SelectedIndexChanged="OnMonedaOrMontoChanged">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>ARS</x:String>
                                        <x:String>USD</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>
                    </Grid>

                    <!-- Feedback de Conversión USD -->
                    <Border x:Name="PnlConversion"
                            IsVisible="False"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}"
                            StrokeThickness="0"
                            Padding="10,6">
                        <Label x:Name="LblConversion"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#047857, Dark=#6EE7B7}" />
                    </Border>

                    <!-- Categoría y Fecha -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#3F3F46}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#27272A}">
                            <Picker x:Name="CboCategoria"
                                    Title="Categoría"
                                    FontSize="13">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Comida</x:String>
                                        <x:String>Transporte</x:String>
                                        <x:String>Servicios</x:String>
                                        <x:String>Salud</x:String>
                                        <x:String>Varios</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>

                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#3F3F46}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#27272A}">
                            <DatePicker x:Name="DtpFecha"
                                        Format="dd/MM/yyyy"
                                        FontSize="13" />
                        </Border>
                    </Grid>

                    <!-- Botón Guardar -->
                    <Button Text="Registrar Gasto"
                            BackgroundColor="#4F46E5"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="15"
                            HeightRequest="46"
                            CornerRadius="10"
                            Clicked="OnGuardarGastoClicked"
                            Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- HISTORIAL DE GASTOS -->
            <Label Text="Historial Reciente"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#334155, Dark=#E4E4E7}"
                   Margin="4,6,0,0" />

            <CollectionView x:Name="ListaGastosView"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No hay gastos registrados todavía."
                           HorizontalOptions="Center"
                           Margin="0,24"
                           FontSize="13"
                           TextColor="Gray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem Text="Eliminar"
                                               BackgroundColor="#EF4444"
                                               Invoked="OnEliminarGastoInvoked"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{AppThemeBinding Light=#F1F5F9, Dark=#27272A}"
                                    StrokeThickness="1"
                                    Padding="14"
                                    Margin="0,4"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">

                                    <!-- Descripción -->
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Descripcion}"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#F4F4F5}"
                                           VerticalOptions="Center" />

                                    <!-- Monto y Badge Moneda -->
                                    <HorizontalStackLayout Grid.Row="0" Grid.Column="1" 
                                                           Spacing="6" 
                                                           VerticalOptions="Center">
                                        <Border StrokeShape="RoundRectangle 4"
                                                BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#312E81}"
                                                Padding="5,1"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding Moneda}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#4F46E5, Dark=#A5B4FC}" />
                                        </Border>

                                        <Label Text="{Binding Monto, StringFormat='${0:N2}'}"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               TextColor="{AppThemeBinding Light=#DC2626, Dark=#F87171}" />
                                    </HorizontalStackLayout>

                                    <!-- Categoría -->
                                    <Border Grid.Row="1" Grid.Column="0"
                                            HorizontalOptions="Start"
                                            StrokeShape="RoundRectangle 6"
                                            BackgroundColor="{Binding Categoria, Converter={StaticResource CatColorConverter}}"
                                            Padding="8,2">
                                        <Label Text="{Binding Categoria}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="White" />
                                    </Border>

                                    <!-- Fecha y Equivalente en ARS -->
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" 
                                                         Spacing="2">
                                        <Label Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}"
                                               FontSize="11"
                                               TextColor="Gray"
                                               HorizontalOptions="End" />

                                        <Label Text="{Binding MontoEnPesos, StringFormat='≈ ${0:N2} ARS'}"
                                               FontSize="11"
                                               TextColor="#059669"
                                               FontAttributes="Bold"
                                               HorizontalOptions="End"
                                               IsVisible="{Binding Moneda, Converter={StaticResource EsDolarConverter}}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>