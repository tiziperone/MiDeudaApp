<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiDeuda.App.FacturasPage"
             Title="Gestión de Facturas"
             BackgroundColor="{AppThemeBinding Light=#F5F7FB, Dark=#1E1E1E}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Tarjeta Total Pendiente -->
            <Border StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light=#D32F2F, Dark=#8A1C1C}"
                    Padding="20">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Total Facturas Pendientes"
                           TextColor="White"
                           FontSize="14"
                           Opacity="0.8" />
                    <Label x:Name="LblTotalPendiente"
                           Text="$ 0,00"
                           TextColor="White"
                           FontSize="28"
                           FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <!-- Formulario de Registro de Factura -->
            <Border StrokeShape="RoundRectangle 12"
                    Padding="16"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D2D}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Nueva Factura / Servicio"
                           FontSize="18"
                           FontAttributes="Bold" />

                    <Entry x:Name="TxtEmisor"
                           Placeholder="Emisor / Proveedor (ej. Telecom, Edesur, Alquiler)" />

                    <Entry x:Name="TxtConcepto"
                           Placeholder="Concepto (ej. Factura mes de Agosto)" />

                    <Entry x:Name="TxtNumero"
                           Placeholder="N° Comprobante (opcional)" />

                    <Grid ColumnDefinitions="2*,1*" ColumnSpacing="10">
                        <Entry x:Name="TxtMonto"
                               Grid.Column="0"
                               Placeholder="Monto Total"
                               Keyboard="Numeric" />
                        <Picker x:Name="CboMoneda"
                                Grid.Column="1"
                                Title="Moneda">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>ARS</x:String>
                                    <x:String>USD</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Fecha Emisión" FontSize="12" TextColor="Gray"/>
                            <DatePicker x:Name="DtpEmision" Format="dd/MM/yyyy" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Fecha Vencimiento" FontSize="12" TextColor="Gray"/>
                            <DatePicker x:Name="DtpVencimiento" Format="dd/MM/yyyy" />
                        </VerticalStackLayout>
                    </Grid>

                    <Button Text="Registrar Factura"
                            BackgroundColor="#D32F2F"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            Clicked="OnGuardarFacturaClicked"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Listado de Facturas -->
            <Label Text="Facturas Registradas"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <CollectionView x:Name="ListaFacturasView"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No hay facturas registradas."
                           HorizontalOptions="Center"
                           Margin="0,20"
                           TextColor="Gray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- Borde con Trigger para bajar la opacidad si está pagada -->
                        <Border StrokeShape="RoundRectangle 8"
                Padding="12"
                Margin="0,4"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D2D}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Estado}" Value="Pagada">
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </Border.Triggers>

                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">

                                <!-- Nombre del Emisor / Proveedor (Se tacha si está pagada) -->
                                <Label Grid.Row="0" Grid.Column="0"
                       Text="{Binding Emisor}"
                       FontAttributes="Bold"
                       FontSize="16">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Estado}" Value="Pagada">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <!-- Monto Total -->
                                <Label Grid.Row="0" Grid.Column="1"
                       Text="{Binding MontoTotal, StringFormat='${0:N2}'}"
                       FontAttributes="Bold"
                       FontSize="16"
                       TextColor="#E74C3C">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Estado}" Value="Pagada">
                                            <Setter Property="TextColor" Value="#2ECC71" />
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <!-- Concepto -->
                                <Label Grid.Row="1" Grid.Column="0"
                       Text="{Binding Concepto}"
                       FontSize="13" />

                                <!-- Estado (Cambia a verde cuando se paga) -->
                                <Label Grid.Row="1" Grid.Column="1"
                       Text="{Binding Estado}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#E67E22">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Estado}" Value="Pagada">
                                            <Setter Property="TextColor" Value="#2ECC71" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <!-- Fecha de Vencimiento -->
                                <Label Grid.Row="2" Grid.Column="0"
                       Text="{Binding FechaVencimiento, StringFormat='Vence: {0:dd/MM/yyyy}'}"
                       FontSize="11"
                       TextColor="Gray" />

                                <!-- Botón de Acción: Pagar / Pagada -->
                                <Button x:Name="BtnAccionPagar"
                        Grid.Row="2" Grid.Column="1"
                        Text="Pagar"
                        FontSize="11"
                        HeightRequest="32"
                        Padding="10,0"
                        BackgroundColor="#2ECC71"
                        TextColor="White"
                        Clicked="OnMarcarPagadaClicked"
                        CommandParameter="{Binding .}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding Estado}" Value="Pagada">
                                            <Setter Property="Text" Value="✓ Pagada" />
                                            <Setter Property="BackgroundColor" Value="#7F8C8D" />
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>